<form class="wfe-form {{#if isMonster}}wfe-monster{{else}}wfe-feral{{/if}}" autocomplete="off">
  <header class="wfe-header">
    <div class="wfe-portrait-frame"><img class="wfe-portrait" src="{{actor.img}}" {{#if editable}}data-edit="img"{{/if}} title="{{actor.name}}" alt="Retrato de {{actor.name}}"></div>
    <div class="wfe-heading"><div class="wfe-eyebrow">WILDERFEAST </div><div class="wfe-nameplate"><span class="wfe-chapter-mark" aria-hidden="true">{{#if isMonster}}M{{else}}F{{/if}}</span><input class="wfe-name" name="name" value="{{actor.name}}" aria-label="Nome" {{#unless editable}}disabled{{/unless}}></div>
      <div class="wfe-header-resources"><label class="wfe-small-frame"><span>Ações</span><div><input name="flags.wilderfeast-enhanced.state.actions" type="number" min="0" value="{{state.actions}}" aria-label="Ações restantes" {{#unless editable}}disabled{{/unless}}><small>/ {{state.actionsMax}}</small></div></label><button type="button" class="wfe-small-frame wfe-harmony-frame" data-wfe-action="harmony" title="Harmonia da matilha"><span>Harmonia</span><strong>{{harmony.value}} <small>/ {{harmony.max}}</small></strong></button>{{#if isWilder}}<label class="wfe-small-frame wfe-specialty-frame"><span>Especialidade</span><input name="flags.wilderfeast-enhanced.identity.specialty" value="{{identity.specialty}}" placeholder="Especialidade" {{#unless editable}}disabled{{/unless}}></label>{{/if}}</div>{{#if isMonster}}<p class="wfe-subtitle">Partes, instintos e comportamento de caçada</p>{{/if}}
    </div>
    <div class="wfe-vigor">
      <div class="wfe-vigor-title">VIGOR <span aria-hidden="true">✦</span></div>
      <div class="wfe-vigor-gauge" style="--wfe-vigor-fill:{{vigorPercent}}%">
        <label class="wfe-vigor-current"><span>Atual</span><input name="system.stamina.value" value="{{system.stamina.value}}" type="number" min="0" aria-label="Vigor atual" {{#unless editable}}disabled{{/unless}}></label>
      </div>
      <div class="wfe-vigor-limit">DE <strong>{{vigorMax}}</strong> <span>VIGOR</span></div>
      <meter class="wfe-vigor-meter" min="0" max="{{vigorMax}}" value="{{vigorValue}}" aria-label="Reserva de Vigor"></meter>
      <label class="wfe-vigor-base">Base<input name="system.stamina.max" value="{{system.stamina.max}}" type="number" min="1" aria-label="Vigor máximo base" {{#unless editable}}disabled{{/unless}}></label>
    </div>
  </header>
  {{#if activeConditions}}<div class="wfe-status-strip">{{#each activeConditions}}<span class="wfe-condition-tag">{{name}} {{level}}</span>{{/each}}</div>{{/if}}
  <nav class="wfe-tabs tabs" data-group="primary"><a data-tab="mechanics">{{#if isMonster}}Caçada{{else}}Ficha{{/if}}</a><a data-tab="conditions">Condições</a><a data-tab="identity">{{#if isMonster}}Ecologia & Guia{{else}}Identidade & Origem{{/if}}</a><a data-tab="notes">Notas & Ferramentas</a></nav>
  <section class="wfe-body">
    <div class="tab wfe-scroll" data-group="primary" data-tab="mechanics">
      <div class="wfe-toolbar wfe-action-toolbar"><button class="wfe-primary" type="button" data-wfe-action="roll" {{#unless editable}}disabled{{/unless}}><span class="wfe-action-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M8 8h.01M16 8h.01M12 12h.01M8 16h.01M16 16h.01" stroke-width="3"/></svg></span><span class="wfe-action-label">Fazer teste</span></button><button type="button" data-wfe-action="attack" {{#unless editable}}disabled{{/unless}}><span class="wfe-action-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m5 19 14-14V2l-3 1L3 16m1-3 7 7M2 22l4-4M14 4l6 6"/></svg></span><span class="wfe-action-label">Atacar</span></button><button type="button" data-wfe-action="damage" {{#unless editable}}disabled{{/unless}}><span class="wfe-action-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20S3 15 3 8a5 5 0 0 1 9-3 5 5 0 0 1 9 3c0 7-9 12-9 12Z"/><path d="m12 5-2 5 4 3-2 4"/></svg></span><span class="wfe-action-label">Sofrer dano</span></button><button type="button" data-wfe-action="spend" {{#unless editable}}disabled{{/unless}}><span class="wfe-action-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2c2 6-4 5-2 10 1-1 2-2 2-4 4 4 6 6 6 9a7 7 0 0 1-14 0c0-5 4-7 8-15Z"/></svg></span><span class="wfe-action-label">Pagar Vigor</span></button><button type="button" data-wfe-action="heal" {{#unless editable}}disabled{{/unless}}><span class="wfe-action-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 13c0-6 5-9 14-10 0 9-3 14-9 14H7Z"/><path d="m3 21 12-12M6 4v5M3.5 6.5h5"/></svg></span><span class="wfe-action-label">Recuperar</span></button><button type="button" data-wfe-action="undo" {{#unless editable}}disabled{{/unless}}><span class="wfe-action-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 8a8 8 0 1 1-1 9M5 3v6h6"/></svg></span><span class="wfe-action-label">Desfazer</span></button></div>
      <div class="wfe-stats"><section class="wfe-panel wfe-style-panel"><h2>Estilos</h2>{{#each styles}}<div class="wfe-stat-row"><button type="button" data-wfe-action="roll" data-style="{{key}}" {{#unless ../editable}}disabled{{/unless}}>{{label}}</button><input name="system.styles.{{key}}.value" value="{{value}}" type="number" min="0" aria-label="{{label}}" {{#unless ../editable}}disabled{{/unless}}></div>{{/each}}</section><section class="wfe-panel wfe-skills-panel"><h2>Habilidades</h2><div class="wfe-skill-grid">{{#each skills}}<div class="wfe-stat-row"><button type="button" data-wfe-action="roll" data-skill="{{key}}" {{#unless ../editable}}disabled{{/unless}}>{{label}}</button><input name="system.skills.{{key}}.value" value="{{value}}" type="number" min="0" aria-label="{{label}}" {{#unless ../editable}}disabled{{/unless}}></div>{{/each}}</div></section></div>
      {{#if isWilder}}<section class="wfe-panel wfe-tool-panel"><h2>Utensílio {{#if toolBroken}}<span class="wfe-broken">QUEBRADO</span>{{/if}}</h2>
        <div class="wfe-tool-display">
          <div class="wfe-tool-emblem"><button type="button" class="wfe-tool-pick" data-wfe-action="tool-configure" title="Escolher e configurar Utensílio" aria-label="Escolher e configurar Utensílio" {{#unless editable}}disabled{{/unless}}>{{#if toolIcon}}<img src="{{toolIcon}}" alt="{{system.tool}}">{{else}}<span class="wfe-tool-empty">✦</span>{{/if}}<span class="wfe-tool-pick-hint">Escolher Utensílio ↗</span></button><label class="wfe-tool-name"><span>Utensílio equipado</span><input name="system.tool" value="{{system.tool}}" placeholder="Seu utensílio" {{#unless editable}}disabled{{/unless}}></label></div>
          <div class="wfe-tool-reach"><span class="wfe-tool-kicker">Alcance</span><label><span>Distância e uso</span><input name="system.range" value="{{system.range}}" {{#unless editable}}disabled{{/unless}}></label><p>Seu companheiro de caçada</p></div>
          <div class="wfe-tool-resource {{#if toolBroken}}is-broken{{/if}}"><div class="wfe-vigor-title">Durabilidade <span>✦</span></div><div class="wfe-tool-gauge" style="--wfe-tool-fill:{{toolPercent}}%"><label><span>Atual</span><input type="number" name="system.durability.value" value="{{system.durability.value}}" min="0" {{#unless editable}}disabled{{/unless}}></label></div><label class="wfe-tool-max">Máxima <input type="number" name="system.durability.max" value="{{system.durability.max}}" min="1" {{#unless editable}}disabled{{/unless}}></label><meter class="wfe-tool-meter" min="0" max="{{system.durability.max}}" value="{{toolValue}}" aria-label="Durabilidade do Utensílio"></meter></div>
        </div>{{#if toolAttacks}}<div class="wfe-tool-attacks"><h3>Ataques do Utensílio</h3><div>{{#each toolAttacks}}<button type="button" data-wfe-action="tool-attack" data-style="{{style}}" data-skill="{{skill}}" {{#unless ../editable}}disabled{{/unless}}><strong>{{label}}</strong><span>{{actionsLabel}} · {{rangeLabel}}</span><small>{{effect}}{{#if broken}} · metade (quebrado){{/if}}</small>{{#if risk}}<small>{{risk}}</small>{{/if}}</button>{{/each}}</div></div>{{/if}}</section>{{/if}}
      <div class="wfe-columns">
        <section class="wfe-panel wfe-parts-techniques"><div class="wfe-section-heading"><h2>{{#if isMonster}}Partes{{else}}Técnicas{{/if}}</h2><button type="button" data-wfe-action="item-create" data-type="{{#if isMonster}}part{{else}}technique{{/if}}" {{#unless editable}}disabled{{/unless}}>+ Criar</button></div>
          {{#if isMonster}}{{#each parts}}<article class="wfe-item {{#if broken}}wfe-item-broken{{/if}}" data-item-id="{{id}}" draggable="true"><details><summary><img src="{{img}}" alt=""><span><strong>{{name}}</strong>{{#if broken}}<small class="wfe-broken">QUEBRADA</small>{{/if}}{{#if meta.burned}}<small class="wfe-broken">QUEIMADA</small>{{/if}}</span><span class="wfe-part-resource"><input data-part-field="value" data-item-id="{{id}}" value="{{durability.value}}" type="number" min="0" aria-label="Durabilidade de {{name}}" {{#unless ../editable}}disabled{{/unless}}> / <input data-part-field="max" data-item-id="{{id}}" value="{{durability.max}}" type="number" min="0" aria-label="Durabilidade máxima de {{name}}" {{#unless ../editable}}disabled{{/unless}}></span></summary><div class="wfe-item-content"><div class="wfe-rule-text">{{{description}}}</div><div class="wfe-item-controls"><button type="button" data-wfe-action="item-use" data-item-id="{{id}}" {{#unless ../editable}}disabled{{/unless}}>Consultar</button><button type="button" data-wfe-action="item-open" data-item-id="{{id}}" {{#unless ../editable}}disabled{{/unless}}>Editar</button><button type="button" data-wfe-action="item-meta" data-item-id="{{id}}" {{#unless ../editable}}disabled{{/unless}}>Configurar</button><button type="button" data-wfe-action="item-delete" data-item-id="{{id}}" {{#unless ../editable}}disabled{{/unless}}>Remover</button></div></div></details></article>{{else}}<p class="wfe-empty">Arraste as partes do monstro ou crie uma nova.</p>{{/each}}{{else}}{{#each techniques}}<article class="wfe-item" data-item-id="{{id}}" draggable="true"><details><summary><img src="{{img}}" alt=""><span><strong>{{name}}</strong><small>{{category}} {{meta.tool}}</small></span><span class="wfe-cost">{{cost}}</span></summary><div class="wfe-item-content"><div class="wfe-rule-text">{{{description}}}</div><div class="wfe-item-controls"><button type="button" data-wfe-action="item-use" data-item-id="{{id}}" {{#unless ../editable}}disabled{{/unless}}>Usar / Consultar</button><button type="button" data-wfe-action="item-open" data-item-id="{{id}}" {{#unless ../editable}}disabled{{/unless}}>Editar</button><button type="button" data-wfe-action="item-meta" data-item-id="{{id}}" {{#unless ../editable}}disabled{{/unless}}>Configurar</button><button type="button" data-wfe-action="item-delete" data-item-id="{{id}}" {{#unless ../editable}}disabled{{/unless}}>Remover</button></div></div></details></article>{{else}}<p class="wfe-empty">Arraste técnicas para a ficha ou crie uma nova.</p>{{/each}}{{/if}}
        </section>
        <section class="wfe-panel wfe-trait-panel"><div class="wfe-section-heading"><h2>Traços</h2><button type="button" data-wfe-action="item-create" data-type="trait" {{#unless editable}}disabled{{/unless}}>+ Criar</button></div><div class="wfe-basic-traits"><strong>Brio</strong> · Gaste um sucesso adicional para +1 em [A].{{#if isWilder}}<br><strong>Tino</strong> · Gaste um sucesso adicional para estabelecer um detalhe.{{/if}}<small>Preserve o último sucesso. Os controles ficam no chat da rolagem.</small></div>{{#each traits}}<article class="wfe-item" data-item-id="{{id}}" draggable="true"><details><summary><img src="{{img}}" alt=""><span><strong>{{name}} {{#if hasLevel}}<b class="wfe-level">{{level}}</b>{{/if}}</strong><small>{{meta.origin}}</small></span><span class="wfe-cost">{{cost}}</span></summary><div class="wfe-item-content"><div class="wfe-rule-text">{{{description}}}</div><div class="wfe-item-controls"><button type="button" data-wfe-action="item-use" data-item-id="{{id}}" {{#unless ../editable}}disabled{{/unless}}>Usar / Consultar</button><button type="button" data-wfe-action="item-open" data-item-id="{{id}}" {{#unless ../editable}}disabled{{/unless}}>Editar</button><button type="button" data-wfe-action="item-meta" data-item-id="{{id}}" {{#unless ../editable}}disabled{{/unless}}>Configurar</button><button type="button" data-wfe-action="item-delete" data-item-id="{{id}}" {{#unless ../editable}}disabled{{/unless}}>Remover</button></div></div></details></article>{{else}}<p class="wfe-empty">Arraste traços ou registre suas mutações.</p>{{/each}}</section>
      </div>
      {{#if recipes}}<section class="wfe-panel wfe-recipes-panel"><h2>Receitas</h2>{{#each recipes}}<article class="wfe-item" data-item-id="{{id}}" draggable="true"><details><summary><img src="{{img}}" alt=""><span><strong>{{name}}</strong><small>Receita · {{meta.origin}}</small></span></summary><div class="wfe-item-content"><div class="wfe-rule-text">{{{description}}}</div><div class="wfe-item-controls"><button type="button" data-wfe-action="item-use" data-item-id="{{id}}" {{#unless ../editable}}disabled{{/unless}}>Consultar</button><button type="button" data-wfe-action="item-open" data-item-id="{{id}}" {{#unless ../editable}}disabled{{/unless}}>Editar</button><button type="button" data-wfe-action="item-delete" data-item-id="{{id}}" {{#unless ../editable}}disabled{{/unless}}>Remover</button></div></div></details></article>{{/each}}</section>{{/if}}
      <section class="wfe-panel wfe-position"><h2>Posição na Caçada</h2><div class="wfe-hunt-board"><div class="wfe-distance-card"><span class="wfe-hunt-kicker">Distância da presa</span><div class="wfe-hunt-route"><span aria-hidden="true">◆</span><label><input name="flags.wilderfeast-enhanced.state.distance" type="number" min="0" value="{{state.distance}}" aria-label="Pernadas de distância" {{#unless editable}}disabled{{/unless}}><span>Pernadas</span></label><span aria-hidden="true">✦</span></div><small>Posição relativa na Caçada</small></div><label class="wfe-terrain-card"><span class="wfe-hunt-kicker">Terreno</span><span class="wfe-terrain-art" aria-hidden="true">◭</span><input name="flags.wilderfeast-enhanced.state.terrain" value="{{state.terrain}}" placeholder="Chão, água, ar…" {{#unless editable}}disabled{{/unless}}></label><label class="wfe-push-card"><span class="wfe-hunt-kicker">Forçar a barra</span><input name="flags.wilderfeast-enhanced.state.pushLimit" type="checkbox" {{checked state.pushLimit}} {{#unless editable}}disabled{{/unless}}><strong>Superar o limite</strong><small>Marque ao realizar testes com Ferido 3.</small></label></div><p class="wfe-muted">A distância é relativa ao monstro escolhido pela mesa; não substitui metros na régua.</p></section>
    </div>
    <div class="tab wfe-scroll" data-group="primary" data-tab="conditions"><section class="wfe-panel"><h2>Condições da criatura</h2><p>Vigor, Ferido, Descansado/Fadigado, Exposto e Atordoado têm controles assistidos. Consulte os lembretes para as demais consequências.</p><div class="wfe-condition-grid">{{#each conditions}}<article class="wfe-condition {{#if active}}active{{/if}}"><div><strong>{{name}}</strong><span class="wfe-condition-controls"><button type="button" data-wfe-action="condition" data-key="{{key}}" data-delta="-1" aria-label="Remover um nível de {{name}}" {{#unless ../editable}}disabled{{/unless}}>−</button><b>{{level}}</b><button type="button" data-wfe-action="condition" data-key="{{key}}" data-delta="1" aria-label="Adicionar um nível de {{name}}" {{#unless ../editable}}disabled{{/unless}}>+</button></span></div><p>{{hint}}</p></article>{{/each}}</div><p class="wfe-muted">Queimado afeta uma Parte: marque em Configurar na própria Parte. Convalescente exige resolução manual.</p></section></div>
    <div class="tab wfe-scroll" data-group="primary" data-tab="identity">{{#if isWilder}}<section class="wfe-panel"><h2>Identidade & Origem em três pratos</h2><div class="wfe-identity-grid">{{#each identityFields}}<label>{{label}}<textarea name="flags.wilderfeast-enhanced.identity.{{key}}" {{#unless ../editable}}disabled{{/unless}}>{{value}}</textarea></label>{{/each}}</div></section>{{else}}<section class="wfe-panel"><h2>Comportamento</h2>{{editor behavior target="system.behavior" button=true engine="prosemirror" owner=owner editable=editable}}</section><section class="wfe-panel"><h2>Referência rápida da Guia</h2>{{editor quickref target="system.quickref" button=true engine="prosemirror" owner=owner editable=editable}}</section>{{/if}}</div>
    <div class="tab wfe-scroll" data-group="primary" data-tab="notes"><section class="wfe-panel"><h2>Descrição & Notas</h2>{{editor description target="system.description" button=true engine="prosemirror" owner=owner editable=editable}}</section>{{#if isWilder}}<section class="wfe-panel"><h2>Equipamento</h2>{{editor equipment target="system.equipment" button=true engine="prosemirror" owner=owner editable=editable}}</section>{{/if}}<section class="wfe-panel"><h2>Ferramentas de manutenção</h2><div class="wfe-toolbar"><button type="button" data-wfe-action="token-bars" {{#unless editable}}disabled{{/unless}}>Corrigir barras do token</button><button type="button" data-wfe-action="migrate-skills" {{#unless editable}}disabled{{/unless}}>Reordenar habilidades antigas</button><button type="button" data-wfe-action="restore-skills" {{#unless editable}}disabled{{/unless}}>Desfazer reordenação</button></div><p>A reordenação só se aplica a fichas preenchidas pelos nomes da tradução incorreta. Confira a prévia antes de aplicar.</p><p class="wfe-muted">As novas informações ficam vinculadas a esta ficha. A ficha básica continua disponível na configuração de ficha do Foundry.</p></section></div>
  </section>
  <div class="wfe-landscape" aria-hidden="true"><span>WILDERFEAST</span></div>
</form>
